APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=replace-with-long-random-secret
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
AI_PROVIDER_ORDER=gemini,groq
AI_TIMEOUT_SECONDS=12
AI_TOTAL_TIMEOUT_SECONDS=35
AI_MAX_OUTPUT_TOKENS=700
# Optional USD rates per 1M tokens; leave empty to disable cost estimates.
AI_COST_RATES_JSON={}
AI_USAGE_ADMIN_IDS=
# Gemini account 1 (primary)
GEMINI_API_KEY=
# Optional Gemini account 2 from a separately configured Google AI Studio project/account.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
DECODO_API_KEY=
LANGSEARCH_API_KEY=
SEARCH_PROVIDER_ORDER=decodo,langsearch,tavily
DECODO_GEO=IN
GROQ_API_KEY=
# Optional second Groq account key
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
