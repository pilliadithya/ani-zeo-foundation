APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=replace-with-long-random-secret
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
AI_PROVIDER_ORDER=gemini,nvidia,groq,openrouter
AI_TIMEOUT_SECONDS=12
AI_TOTAL_TIMEOUT_SECONDS=35
AI_MAX_OUTPUT_TOKENS=700
# Optional USD rates per 1M tokens; leave empty to disable cost estimates.
# Example: {"gemini":{"input_per_million_usd":0.1,"output_per_million_usd":0.4}}
AI_COST_RATES_JSON={}
# Optional comma-separated Telegram user IDs allowed to run /aiusage.
AI_USAGE_ADMIN_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
DECODO_API_KEY=
LANGSEARCH_API_KEY=
SEARCH_PROVIDER_ORDER=decodo,langsearch,tavily
DECODO_GEO=IN
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
