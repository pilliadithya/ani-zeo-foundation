APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=replace-with-long-random-secret
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
AI_PROVIDER_ORDER=gemini,groq,nvidia,openrouter
AI_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=700
# Optional USD rates per 1M tokens; leave empty to disable cost estimates.
# Example: {"gemini":{"input_per_million_usd":0.1,"output_per_million_usd":0.4}}
AI_COST_RATES_JSON={}
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
